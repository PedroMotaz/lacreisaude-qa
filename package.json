{
  "name": "lacreisaude-qa",
  "version": "1.0.0",
  "description": "Documentar e validar o comportamento da aplicação em ambiente de staging, registrando os resultados dos testes, bugs encontrados e possíveis melhorias.",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:cadastro": "cypress run --spec cypress/e2e/features/cadastro.feature",
    "test:pos-cadastro": "cypress run --spec cypress/e2e/features/pos-cadastro.feature",
    "test:busca": "cypress run --spec cypress/e2e/features/busca-profissional.feature"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroMotaz/lacreisaude-qa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PedroMotaz/lacreisaude-qa/issues"
  },
  "homepage": "https://github.com/PedroMotaz/lacreisaude-qa#readme",
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/support/step_definitions/**/*.js"
    ],
    "json": {
      "enabled": true,
      "output": "cypress/reports/json/cucumber.json"
    }
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.1.0"
  }
}
